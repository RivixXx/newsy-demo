generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum ChallengeFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum ChallengeType {
  OPEN      // Открытый — участвовать может каждый
  CLOSED    // Закрытый — организатор согласовывает участие
}

enum CancellationPolicy {
  FULL_REFUND_24H   // Полный возврат за 24ч до начала
  FULL_REFUND_7D    // Полный возврат за 7 дней до начала
  NO_REFUND         // Без возврата
}

enum OrganizerType {
  BRAND
  INFLUENCER
  NGO
  GOVERNMENT
  OTHER
}

enum OrganizerStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum ChallengeStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum OrganizerMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizerMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum UserProgressStatus {
  JOINED
  IN_PROGRESS
  COMPLETED
  FAILED
  WITHDRAWN
}

enum StepProgressStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum OwnershipType {
  USER
  ORGANIZER
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum NotificationType {
  CHALLENGE_CREATED
  CHALLENGE_UPDATED
  STEP_COMPLETED
  REWARD_EARNED
  SYSTEM
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum AccountType {
  INDIVIDUAL
  IP
  OOO
  AO
  SELF_EMPLOYED
}

model User {
  id             String          @id @default(uuid())
  email          String?         @unique
  phone          String?         @unique
  passwordHash   String
  firstName      String
  lastName       String
  status         UserStatus      @default(PENDING)
  points         Int             @default(0)
  rating         Float           @default(0)
  lastLoginAt       DateTime?
  totpEnabled       Boolean       @default(false) @map("totp_enabled")
  totpSecret        String?       @map("totp_secret")
  totpBackupCodes   String?       @map("totp_backup_codes")
  totpVerifiedAt    DateTime?     @map("totp_verified_at")
  referredBy     String?
  referralCode   String?         @unique
  gender         String?
  birthDate      DateTime?
  bio            String?
  avatarUrl      String?
  accountType    AccountType     @default(INDIVIDUAL)
  companyName    String?
  inn            String?
  companySize    String?
  employeeCount  Int?
  companyAddress String?
  platformName   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  roles                 UserRole[]
  organizerMembership   OrganizerMember[]
  searchSessions        SearchSession[]
  savedSearches         SavedSearch[]
  favorites             Favorite[]
  participations        UserProgress[]
  achievements          UserAchievement[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  subscriptions         UserSubscription[]
  chatMessages          ChatMessage[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  referredByUser          ReferralEvent[] @relation("ReferralEventsAsReferrer")
  referredUser            ReferralEvent[] @relation("ReferralEventsAsReferred")
  reports                 Report[]
  teamsAsCaptain          Team[]
  teamMemberships         TeamMember[]
  userPromos               UserPromoCode[]
  prizeRedemptions         PrizeRedemption[]

  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String         @id @default(uuid())
  key         String         @unique
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  permissions PermissionRole[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       PermissionRole[]
}

model PermissionRole {
  id            String      @id @default(uuid())
  roleId        String
  permissionId  String
  createdAt     DateTime    @default(now())

  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Organizer {
  id          String               @id @default(uuid())
  type        OrganizerType
  name        String
  legalName   String?
  inn         String?              @unique
  kpp         String?
  ogrn        String?
  legalAddress String?
  taxId       String?              @unique
  description String?
  contactEmail String?
  contactPhone String?
  isVerified  Boolean              @default(false)
  verifiedAt  DateTime?
  status      OrganizerStatus      @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  members     OrganizerMember[]
  challenges  Challenge[]
  payments    PaymentTransaction[]
  payouts     CommissionPayout[]
  coOrganizedChallenge ChallengeOrganizer[]

  @@index([type])
  @@index([status])
  @@index([deletedAt])
}

model OrganizerMember {
  id                 String                @id @default(uuid())
  organizerId        String
  userId             String
  roleInOrganizer    OrganizerMemberRole   @default(MEMBER)
  status             OrganizerMemberStatus @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  organizer          Organizer     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerId, userId])
  @@index([organizerId])
  @@index([userId])
  @@index([status])
}

model Challenge {
  id              String                 @id @default(uuid())
  organizerId     String
  status          ChallengeStatus        @default(DRAFT)
  title           String
  description     String?
  category        String?
  format          ChallengeFormat        @default(ONLINE)
  challengeType   ChallengeType         @default(OPEN)
  country         String?
  region          String?                // Регион/город для фильтрации
  city            String?
  address         String?                // Адрес места проведения (для OFFLINE/HYBRID)
  latitude        Float?                 // Широта для карты
  longitude       Float?                 // Долгота для карты
  startTime       String?                // Время начала (HH:MM)
  endTime         String?                // Время окончания (HH:MM)
  requirements    String?                // Требования к участникам
  minAge          Int?                   // Минимальный возраст
  maxAge          Int?                   // Максимальный возраст
  gender          String?                // 'male', 'female', null (все)
  cancellationPolicy CancellationPolicy  @default(FULL_REFUND_24H)
  maxParticipants Int?                   // null = без ограничений
  isCooperative   Boolean                @default(false)
  startDate       DateTime?
  endDate         DateTime?
  entryFee        Float                  @default(0)
  publishPrice    Float?                 @default(1000.00)
  rejectionReason String?
  // Branded Challenge fields
  brandLogoUrl    String?                // URL логотипа бренда
  brandPrimaryColor String?              // Основной цвет бренда
  brandSecondaryColor String?            // Дополнительный цвет бренда
  brandBannerUrl  String?                // Баннер для страницы ЧИ
  sponsorName     String?                // Название спонсора
  sponsorUrl      String?                // Ссылка на спонсора
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  organizer       Organizer              @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  steps           Step[]
  media           ChallengeMedia[]
  participations  UserProgress[]
  favorites       Favorite[]
  partners        ChallengePartner[]
  payments        PaymentTransaction[]
  commission      CommissionConfig?
  chatMessages    ChatMessage[]
  coOrganizers    ChallengeOrganizer[]
  rewards         ChallengeReward[]
  teams           Team[]
  promoCodes      PromoCode[]

  @@index([organizerId])
  @@index([status])
  @@index([category])
  @@index([deletedAt])
}

model Step {
  id              String           @id @default(uuid())
  challengeId     String
  title           String
  description     String?
  order           Int              @default(0)
  type            String           // E.g., "QUESTION", "PHOTO", "LOCATION", "ACTION"
  config          Json?            // Validation rules, correct answers, etc.
  criteria        String?          // Критерии приёма этапа организатором
  rewardPoints    Int              @default(0)
  // A/B testing fields
  variant         String?          // "A" or "B" — вариант для A/B теста
  parentStepId    String?          // ID родительского этапа (для A/B пар)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  challenge       Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userProgress    StepProgress[]

  @@index([challengeId])
  @@index([order])
  @@index([parentStepId])
}

model ChallengeMedia {
  id           String    @id @default(uuid())
  challengeId  String
  type         MediaType
  url          String
  sortOrder    Int       @default(0)
  altText      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([type])
}

model ChallengePartner {
  id              String    @id @default(uuid())
  challengeId     String
  partnerName     String
  partnerLogoUrl  String?
  createdAt       DateTime  @default(now())

  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model UserProgress {
  id              String              @id @default(uuid())
  userId          String
  challengeId     String
  status          UserProgressStatus  @default(JOINED)
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge       Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  stepProgress    StepProgress[]

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([status])
}

model StepProgress {
  id              String              @id @default(uuid())
  userProgressId  String
  stepId          String
  status          StepProgressStatus  @default(PENDING)
  submission      Json?               // Ответ пользователя: текст, ссылка на фото, координаты и т.д.
  pointsEarned    Int                 @default(0)
  completedAt     DateTime?
  reviewedAt      DateTime?           // Когда организатор проверил
  reviewNote      String?             // Комментарий при отклонении
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  userProgress    UserProgress     @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  step            Step             @relation(fields: [stepId], references: [id], onDelete: Restrict)

  @@unique([userProgressId, stepId])
  @@index([userProgressId])
  @@index([stepId])
  @@index([status])
}

model Achievement {
  id              String           @id @default(uuid())
  key             String           @unique
  name            String
  description     String?
  icon            String?          // Emoji или имя иконки
  badgeUrl        String?
  category        String?          // Категория: progress, social, sport, education, art, eco, streak, special, organizer
  isCustom        Boolean          @default(false)
  isApproved      Boolean          @default(true)
  pointsRequired  Int?             @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           UserAchievement[]
  challengeRewards ChallengeReward[]
}

model ChallengeReward {
  id              String           @id @default(uuid())
  challengeId     String
  achievementId   String?
  rewardName      String?
  rewardDescription String?
  createdAt       DateTime         @default(now())

  challenge       Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  achievement     Achievement?     @relation(fields: [achievementId], references: [id], onDelete: SetNull)

  @@index([challengeId])
  @@index([achievementId])
}

model PromoCode {
  id              String           @id @default(uuid())
  challengeId     String
  code            String
  description     String?
  discountPercent Int?             // Скидка в процентах
  discountAmount  Float?           // Скидка в деньгах
  maxUses         Int              @default(100)
  usedCount       Int              @default(0)
  validUntil      DateTime?
  createdAt       DateTime         @default(now())

  challenge       Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userPromos      UserPromoCode[]

  @@unique([challengeId, code])
  @@index([challengeId])
}

model UserPromoCode {
  id              String           @id @default(uuid())
  userId          String
  promoCodeId     String
  earnedAt        DateTime         @default(now())
  usedAt          DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode       PromoCode        @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@index([userId])
  @@index([promoCodeId])
}

model UserAchievement {
  id              String           @id @default(uuid())
  userId          String
  achievementId   String
  earnedAt        DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement      @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Team {
  id              String         @id @default(uuid())
  challengeId     String
  name            String
  captainId       String
  inviteCode      String         @unique
  maxMembers      Int            @default(10)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  challenge       Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  captain         User           @relation(fields: [captainId], references: [id], onDelete: Cascade)
  members         TeamMember[]

  @@index([challengeId])
  @@index([inviteCode])
}

model TeamMember {
  id              String         @id @default(uuid())
  teamId          String
  userId          String
  role            String         @default("MEMBER")
  joinedAt        DateTime       @default(now())

  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Prize {
  id              String         @id @default(uuid())
  name            String
  description     String?
  imageUrl        String?
  cost            Int            // Стоимость в баллах
  stock           Int            @default(100)
  sponsorId       String?        // ID спонсора (организатора)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  redemptions     PrizeRedemption[]

  @@index([isActive])
}

model PrizeRedemption {
  id              String         @id @default(uuid())
  userId          String
  prizeId         String
  pointsSpent     Int
  status          String         @default("PENDING")
  createdAt       DateTime       @default(now())
  deliveredAt     DateTime?

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prize           Prize          @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  @@unique([userId, prizeId])
  @@index([userId])
  @@index([prizeId])
}

model SearchSession {
  id              String    @id @default(uuid())
  userId          String?
  sessionKey      String    @unique
  query           String?
  filters         Json
  sort            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deletedAt])
}

model SavedSearch {
  id        String    @id @default(uuid())
  userId    String
  name      String
  query     String?
  filters   Json
  sort      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([deletedAt])
}

model Favorite {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  payload   Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([deletedAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  beforeState   Json?
  afterState    Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model PaymentTransaction {
  id              String            @id @default(uuid())
  organizerId     String
  challengeId     String
  amount          Float
  currency        String            @default("RUB")
  provider        String            @default("YOOKASSA")
  providerId      String?           @unique
  type            String            @default("PUBLISH_CHALLENGE")
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organizer       Organizer         @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  challenge       Challenge         @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@index([organizerId])
  @@index([challengeId])
  @@index([status])
  @@index([providerId])
}

model SubscriptionPlan {
  id              String               @id @default(uuid())
  key             String               @unique
  name            String
  description     String?
  price           Float
  currency        String               @default("RUB")
  interval        SubscriptionInterval @default(MONTHLY)
  features        Json
  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  subscriptions   UserSubscription[]

  @@index([key])
  @@index([isActive])
}

model UserSubscription {
  id              String             @id @default(uuid())
  userId          String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  providerId      String?            @unique
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([providerId])
}

model CommissionConfig {
  id              String    @id @default(uuid())
  challengeId     String    @unique
  rate            Float
  platformShare   Float
  organizerShare  Float
  createdAt       DateTime  @default(now())

  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model CommissionPayout {
  id              String            @id @default(uuid())
  organizerId     String
  amount          Float
  currency        String            @default("RUB")
  status          TransactionStatus @default(PENDING)
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organizer       Organizer         @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  @@index([organizerId])
  @@index([status])
  @@index([periodStart])
}

model ChatMessage {
  id              String    @id @default(uuid())
  challengeId     String
  userId          String
  text            String
  createdAt       DateTime  @default(now())

  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([createdAt])
}

model ChallengeOrganizer {
  id            String    @id @default(uuid())
  challengeId   String
  organizerId   String
  sharePercent  Float     @default(0)
  createdAt     DateTime  @default(now())

  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  organizer     Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([challengeId, organizerId])
  @@index([challengeId])
  @@index([organizerId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum ReferralEventType {
  REGISTRATION
  FIRST_CHALLENGE
  PAYMENT
  ORGANIZER_REFERRAL
}

model ReferralEvent {
  id            String              @id @default(uuid())
  referrerId    String
  referredId    String
  eventType     ReferralEventType
  rewardAmount  Float               @default(0)
  createdAt     DateTime            @default(now())

  referrer      User                @relation("ReferralEventsAsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User                @relation("ReferralEventsAsReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId, eventType])
  @@index([referrerId])
  @@index([referredId])
  @@index([eventType])
}

model Report {
  id            String   @id @default(uuid())
  reporterId    String
  challengeId   String?
  userId        String?
  reason        String
  description   String?
  status        String   @default("PENDING")
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime @default(now())

  reporter      User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([challengeId])
  @@index([status])
}

model RevokedSession {
  id              String   @id @default(uuid())
  sessionTokenHash String  @unique
  createdAt       DateTime @default(now())
}
