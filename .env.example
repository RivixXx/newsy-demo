# Database (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Authentication — REQUIRED in production
NEXTAUTH_URL="https://your-domain.vercel.app"
# Optional public alias. Password-reset links fall back to NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Node Environment
NODE_ENV="production"

# Payments (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Supabase (storage)
# Find in Supabase Dashboard → Settings → API:
#   URL → NEXT_PUBLIC_SUPABASE_URL
#   anon public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role key → SUPABASE_SERVICE_ROLE_KEY (Settings → API → service_role)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Rate Limiting — REQUIRED for production to prevent brute-force in serverless.
# IMPORTANT: rate limiting is FAIL-CLOSED in production — if Upstash is not
# configured (or errors), rate-limited requests are DENIED instead of allowed.
# Sign up at https://upstash.com and create a Redis database.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (Resend) — REQUIRED for email verification & password reset
# Sign up at https://resend.com, create API key
# In dev, use onboarding@resend.dev (Resend's default sandbox domain)
# In production, verify your own domain and set EMAIL_FROM accordingly
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Telegram Bot (optional)
# Create bot via @BotFather in Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="chi-webhook"
