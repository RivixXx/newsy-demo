# Database (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Authentication — REQUIRED in production
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Node Environment
NODE_ENV="production"

# YooKassa (payments) — REQUIRED in production, mock mode in development only
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# YOOKASSA_WEBHOOK_SECRET — optional but recommended for HMAC webhook verification
# Set in YooKassa Dashboard → Webhooks → Secret key
YOOKASSA_WEBHOOK_SECRET=""

# Supabase (storage)
# Find in Supabase Dashboard → Settings → API:
#   URL → NEXT_PUBLIC_SUPABASE_URL
#   anon public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role key → SUPABASE_SERVICE_ROLE_KEY (Settings → API → service_role)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Rate Limiting — recommended for production to prevent brute-force in serverless
# Without this, in-memory rate limiter is used (does NOT work in multi-instance/Vercel)
# Sign up at https://upstash.com and create a Redis database
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
